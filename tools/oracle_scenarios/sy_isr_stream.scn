# SY1SY2 audio ISR with the firmware's own initialisation script and the real packed sample
# stream (`stream` DMA model) for the pitch entry writer hunt (docs/research/sy-pitch-entry-writer.md
# section 7, D111).
#
# To produce the local stream file (never committed):
#   ns4 backup "<ns4b>" --extract "Samp Lib/Accordion_Harm/Weltmeister 4 Accordion_PS 4.1.nsmp4" <scratch>/weltmeister.nsmp4
#   Extract stroke 0's `\0stk` payload after the 68-byte header and zero-word padding
#   (file bytes 0x8B0..0x13B0, 704 big-endian u32 words including the 0x00800020 end sentinel)
#   byte-swapped to little-endian 32-bit words into target/oracle/weltmeister_s0.stream (the scenario path is relative to the working directory).
#
# Run:
#   sharc-ref sy.bin tools/oracle_scenarios/sy_isr_stream.scn --out <scratch>/stream --watch 0x93500:0xA0
meta rate 48000
warmup 0x1c0b2d 100000 flag12=1
poke 0x93E0C 0xFFFFFFFF
poke 0x93E0D 0xFFFFFFFF
poke 0x93E12 0xFFFFFFFF
poke 0x93E13 0xFFFFFFFF
poke 0x93E18 0xFFFFFFFF
poke 0x93E19 0xFFFFFFFF
poke 0x93E1E 0xFFFFFFFF
poke 0x93E1F 0xFFFFFFFF
poke 0x93E20 0x1
poke 0x95C69 0x92426
poke 0x95C6A 0x0
poke 0x95C6B 0x92426
poke 0x95C7B 0x95C6D
poke 0x95C7C 0x1C12DD
poke 0x95C7D 0x1C12DD
poke 0x95C7E 0x1C12DD
poke 0x95C7F 0x1C12DD
poke 0x95C80 0x1C14BD
poke 0x95C81 0x1C14B6
poke 0x95C82 0x1C15CB
poke 0x95C83 0x1C15C4
poke 0x95C84 0x1C16DC
poke 0x95C85 0x1C16D5
poke 0x95C86 0x1C17EC
poke 0x95C87 0x1C17E5
poke 0x95C88 0x1C1901
poke 0x95C89 0x1C18FA
poke 0x95C8A 0x1C1A17
poke 0x95C8B 0x1C1A10
poke 0x95C8C 0x1C1B30
poke 0x95C8D 0x1C1B29
poke 0x95C8E 0x1C1C44
poke 0x95C8F 0x1C1C3D
poke 0x95C90 0x1C1D61
poke 0x95C91 0x1C1D5A
poke 0x95C92 0x1C1E7F
poke 0x95C93 0x1C1E78
poke 0x95C94 0x1C1FA0
poke 0x95C95 0x1C1F99
poke 0x95C96 0x1C20C0
poke 0x95C97 0x1C20B9
poke 0x95C98 0x1C21E5
poke 0x95C99 0x1C21DE
poke 0x95C9A 0x1C12E7
poke 0x95C9B 0x1C12E0
poke 0x95C9C 0x1C12DD
poke 0x95C9D 0x1C12DD
poke 0x95CBC 0xA5A5A5A5
poke 0x95CBD 0xB4B4B4B4
poke 0x95CBE 0xC3C3C3C3
poke 0x95CBF 0xD2D2D2D2
poke 0x95CC0 0xE1E1E1E1
poke 0x95CC1 0xF0F0F0F0
irq 13
stream 0 path=target/oracle/weltmeister_s0.stream
msg 0x92414 0x1c0794
msg 0xc1dcc 0x4000100
msg 0x92414 0x1c0794
msg 0x92416 0
msg 0x92420 0x3f128f5c
msg 0x92421 0xbedae148
msg 0x9240a 0xc
msg 0x9240b 0x2c60
msg 0x92413 7
msg 0x9240c 0xd
msg 0x9240d 0xb40
msg 0x9240e 0xd
msg 0x9240f 0xbe0
msg 0x92414 0x1c07cd
msg 0x92433 0
msg 0x9243b 0xe4c00
msg 0x921a6 0x3c748500
msg 0x92432 0xbf800000
irq 17 400000
irq 13
msg 0x92414 0x1c084c
loop 400
irq 17 400000
end
capture step 0x9242d 1
capture ringL 0xC0000 128 stride=2
capture ringR 0xC0001 128 stride=2
